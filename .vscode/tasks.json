{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Exporter PDF avec Pandoc",
            "type": "shell",
            "command": "pandoc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}/pdf/${fileBasenameNoExtension}.pdf",
                "--pdf-engine=xelatex",
                "--from=markdown",
                "--to=pdf",
                "--metadata-file=${workspaceFolder}/custom.latex.yaml",
                "--syntax-highlighting=zenburn",
                "--number-sections"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "(Enric) Exporter un PDF avec Pandoc",
            "type": "shell",
            "command": "bash",
            "args": ["./enric_export_single_pdf.sh", "${fileBasename}"],
            "group": {
                "kind": "none"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "(Enric) Exporter tous PDFs avec Pandoc",
            "type": "shell",
            "command": "bash",
            "args": ["./enric_export_pdf.sh"],
            "group": {
                "kind": "build"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Exporter HTML avec Eleventy",
            "type": "shell",
            "command": "bash",
            "args": ["html_build.sh"],
            "group": {
                "kind": "build"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
